{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "shortcuts",
  "title": "Shortcuts",
  "description": "Quick reference for keyboard shortcuts across your favorite apps",
  "icon": "extension-icon.png",
  "author": "jonas",
  "categories": [
    "Productivity",
    "Developer Tools"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "shortcuts",
      "title": "Search Shortcuts",
      "description": "Browse and search keyboard shortcuts for various apps",
      "mode": "view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.104.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.1.1",
    "@types/node": "22.13.10",
    "@types/react": "19.0.10",
    "eslint": "^9.0.0",
    "prettier": "^3.3.3",
    "typescript": "^5.3.2"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish"
  }
}