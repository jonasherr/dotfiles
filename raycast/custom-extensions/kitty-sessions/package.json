{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "kitty-sessions",
  "title": "Kitty Sessions",
  "description": "Switch between kitty terminal sessions",
  "icon": "extension-icon.png",
  "author": "jonas",
  "categories": [
    "Developer Tools"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "switch-session",
      "title": "Switch Kitty Session",
      "description": "List and switch between kitty terminal sessions",
      "mode": "view",
      "preferences": [
        {
          "name": "customersDirectory",
          "type": "textfield",
          "required": false,
          "title": "Customers Directory",
          "description": "Directory containing one folder per customer",
          "placeholder": "~/Projects/private/customers"
        },
        {
          "name": "customerAdminUrlTemplate",
          "type": "textfield",
          "required": false,
          "title": "Customer Admin URL Template",
          "description": "Optional URL template. Use {team_id} as the identifier placeholder.",
          "placeholder": "https://admin.example.com/team/{team_id}"
        }
      ]
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.104.24",
    "@raycast/utils": "^2.3.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.2.0",
    "@types/node": "22.19.17",
    "@types/react": "19.0.10",
    "eslint": "^9.39.5",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint"
  }
}
