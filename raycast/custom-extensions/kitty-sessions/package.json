{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "kitty-sessions",
  "title": "Kitty Sessions",
  "description": "Switch between kitty terminal sessions",
  "icon": "extension-icon.png",
  "author": "jonas",
  "categories": [
    "Developer Tools"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "switch-session",
      "title": "Switch Kitty Session",
      "description": "List and switch between kitty terminal sessions",
      "mode": "view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.104.0",
    "@raycast/utils": "^2.2.3"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.1.1",
    "@types/node": "22.13.10",
    "@types/react": "19.0.10",
    "eslint": "^9.0.0",
    "prettier": "^3.3.3",
    "typescript": "^5.3.2"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint"
  }
}
