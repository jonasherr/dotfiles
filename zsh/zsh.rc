# Minimal fast zsh config - no Oh-My-Zsh
# Startup target: <300ms

# Enable Powerlevel10k instant prompt (must be at the top)
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# ============================================================================
# Core Settings
# ============================================================================

# History
HISTFILE=~/.zsh_history
HISTSIZE=10000
SAVEHIST=10000
setopt SHARE_HISTORY          # Share history between sessions
setopt HIST_IGNORE_DUPS       # Don't record duplicates
setopt HIST_IGNORE_SPACE      # Don't record commands starting with space
setopt HIST_REDUCE_BLANKS     # Remove extra blanks

# Directory navigation
setopt AUTO_CD                # cd by typing directory name
setopt AUTO_PUSHD             # Push directories onto stack
setopt PUSHD_IGNORE_DUPS      # Don't push duplicates
setopt PUSHD_SILENT           # Don't print directory stack

# Completion
autoload -Uz compinit
# Only regenerate compinit cache once per day
if [[ -n ~/.zcompdump(#qN.mh+24) ]]; then
  compinit
else
  compinit -C  # Use cached completions (much faster)
fi

# Completion styling
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'  # Case insensitive
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"

# ============================================================================
# Vi Mode
# ============================================================================

bindkey -v                    # Enable vi mode
export KEYTIMEOUT=1           # Reduce mode switch delay (10ms)

# Better vi mode bindings
bindkey '^?' backward-delete-char   # Backspace works in insert mode
bindkey '^h' backward-delete-char   # Ctrl+h = backspace
bindkey '^w' backward-kill-word     # Ctrl+w = delete word
bindkey '^a' beginning-of-line      # Ctrl+a = start of line
bindkey '^e' end-of-line            # Ctrl+e = end of line
bindkey '^k' kill-line              # Ctrl+k = kill to end
bindkey '^u' backward-kill-line     # Ctrl+u = kill to start

# Search history with arrows in normal mode
bindkey '^[[A' history-search-backward
bindkey '^[[B' history-search-forward

# Mode indicators (optional - p10k handles this)
MODE_INDICATOR="%F{white}+%f"
INSERT_MODE_INDICATOR="%F{yellow}i%f"
NORMAL_MODE_INDICATOR="%F{yellow}n%f"

# ============================================================================
# Plugins (minimal, direct sourcing)
# ============================================================================

# zsh-autosuggestions
if [[ -f $DOTFILES/zsh/custom/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh ]]; then
  source $DOTFILES/zsh/custom/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh
fi

# television shell integration (ctrl-r history, ctrl-t autocomplete)
if (( $+commands[tv] )); then
  eval "$(tv init zsh)"
fi

# z - directory jumping
# Install with: brew install z
# Or use zoxide (faster): brew install zoxide && add "eval $(zoxide init zsh)"
if [[ -f /opt/homebrew/etc/profile.d/z.sh ]]; then
  source /opt/homebrew/etc/profile.d/z.sh
elif [[ -f /usr/local/etc/profile.d/z.sh ]]; then
  source /usr/local/etc/profile.d/z.sh
elif (( $+commands[zoxide] )); then
  eval "$(zoxide init zsh)"
fi

# ============================================================================
# Powerlevel10k
# ============================================================================

# Load p10k theme
source $DOTFILES/zsh/custom/themes/powerlevel10k/powerlevel10k.zsh-theme

# Load p10k config
[[ -f ~/.p10k.zsh ]] && source ~/.p10k.zsh

# ============================================================================
# Environment & Aliases
# ============================================================================

[[ -f $HOME/.env.sh ]] && source $HOME/.env.sh
[[ -f $DOTFILES/zsh/aliases.zsh ]] && source $DOTFILES/zsh/aliases.zsh

export VISUAL=nvim
export EDITOR=nvim
export MANPAGER="nvim +Man!"
export PAGER="less -S"

# ============================================================================
# Tools
# ============================================================================

# fnm (Node version manager)
eval "$(fnm env --use-on-cd --shell zsh --log-level=quiet)"

# Yazi shell wrapper
function y() {
  local tmp="$(mktemp -t "yazi-cwd.XXXXXX")"
  yazi "$@" --cwd-file="$tmp"
  if cwd="$(cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
    builtin cd -- "$cwd"
  fi
  rm -f -- "$tmp"
}

# bun completions
[[ -s "$HOME/.bun/_bun" ]] && source "$HOME/.bun/_bun"
