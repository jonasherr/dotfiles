# Minimal fast zsh config - no Oh-My-Zsh
# Startup target: <300ms

# Enable Powerlevel10k instant prompt (must be at the top)
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# ============================================================================
# Core Settings
# ============================================================================

# History
HISTFILE=~/.zsh_history
HISTSIZE=10000
SAVEHIST=10000
setopt SHARE_HISTORY          # Share history between sessions
setopt HIST_IGNORE_DUPS       # Don't record duplicates
setopt HIST_IGNORE_SPACE      # Don't record commands starting with space
setopt HIST_REDUCE_BLANKS     # Remove extra blanks

# Directory navigation
setopt AUTO_CD                # cd by typing directory name
setopt AUTO_PUSHD             # Push directories onto stack
setopt PUSHD_IGNORE_DUPS      # Don't push duplicates
setopt PUSHD_SILENT           # Don't print directory stack

# Completion
autoload -Uz compinit
# Only regenerate compinit cache once per day
if [[ -n ~/.zcompdump(#qN.mh+24) ]]; then
  compinit
else
  compinit -C  # Use cached completions (much faster)
fi

# Completion styling
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'  # Case insensitive
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"

# ============================================================================
# Vi Mode
# ============================================================================

bindkey -v                    # Enable vi mode
export KEYTIMEOUT=1           # Reduce mode switch delay (10ms)

# Restore useful emacs bindings in insert mode (scoped to -M viins)
bindkey -M viins '^?' backward-delete-char   # Backspace past insert entry point
bindkey -M viins '^H' backward-delete-char   # Ctrl+h = backspace
bindkey -M viins '^W' backward-kill-word     # Ctrl+w = delete word
bindkey -M viins '^A' beginning-of-line      # Ctrl+a = start of line
bindkey -M viins '^E' end-of-line            # Ctrl+e = end of line
bindkey -M viins '^K' kill-line              # Ctrl+k = kill to end
bindkey -M viins '^U' backward-kill-line     # Ctrl+u = kill to start

# Search history with arrows (insert mode)
bindkey -M viins '^[[A' history-search-backward
bindkey -M viins '^[[B' history-search-forward

# Cursor shape: beam in insert mode, block in normal mode
function zle-keymap-select {
  case $KEYMAP in
    vicmd)      echo -ne '\e[2 q' ;;  # steady block
    viins|main) echo -ne '\e[6 q' ;;  # steady beam
  esac
}
zle -N zle-keymap-select

function zle-line-init { echo -ne '\e[6 q' }
zle -N zle-line-init

echo -ne '\e[6 q'                    # beam on shell start
preexec() { echo -ne '\e[6 q' }      # beam before each command

# Edit command line in $EDITOR (replaces vv which breaks at KEYTIMEOUT=1)
autoload -Uz edit-command-line
zle -N edit-command-line
bindkey -M vicmd '^V' edit-command-line      # Ctrl+V in normal mode
bindkey -M viins '^X^E' edit-command-line    # Ctrl+X Ctrl+E in insert mode

# Vi keys in tab completion menu (requires complist module for menuselect keymap)
zmodload -i zsh/complist
bindkey -M menuselect 'h' vi-backward-char
bindkey -M menuselect 'j' vi-down-line-or-history
bindkey -M menuselect 'k' vi-up-line-or-history
bindkey -M menuselect 'l' vi-forward-char
bindkey -M menuselect '^[' send-break        # ESC cancels menu

# Text objects: ci", di(, ya{, va<, etc.
autoload -Uz select-quoted select-bracketed
zle -N select-quoted
zle -N select-bracketed
for m in visual viopp; do
  for c in {a,i}{\',\",\`}; do
    bindkey -M $m $c select-quoted
  done
  for c in {a,i}${(s..)^:-'()[]{}<>bB'}; do
    bindkey -M $m $c select-bracketed
  done
done
unset m c

# ============================================================================
# Plugins (minimal, direct sourcing)
# ============================================================================

# zsh-autosuggestions
if [[ -f $DOTFILES/zsh/custom/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh ]]; then
  source $DOTFILES/zsh/custom/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh
  # Don't let 'A' in vi normal mode accept the ghost suggestion
  # (it should enter insert mode at EOL like real vim)
  ZSH_AUTOSUGGEST_ACCEPT_WIDGETS=(${ZSH_AUTOSUGGEST_ACCEPT_WIDGETS:#vi-add-eol})
fi

# television shell integration (ctrl-r history, ctrl-t autocomplete)
if (( $+commands[tv] )); then
  eval "$(tv init zsh)"
fi

# z - directory jumping
# Install with: brew install z
# Or use zoxide (faster): brew install zoxide && add "eval $(zoxide init zsh)"
if [[ -f /opt/homebrew/etc/profile.d/z.sh ]]; then
  source /opt/homebrew/etc/profile.d/z.sh
elif [[ -f /usr/local/etc/profile.d/z.sh ]]; then
  source /usr/local/etc/profile.d/z.sh
elif (( $+commands[zoxide] )); then
  eval "$(zoxide init zsh)"
fi

# ============================================================================
# Powerlevel10k
# ============================================================================

# Load p10k theme
source $DOTFILES/zsh/custom/themes/powerlevel10k/powerlevel10k.zsh-theme

# Load p10k config
[[ -f ~/.p10k.zsh ]] && source ~/.p10k.zsh

# ============================================================================
# Environment & Aliases
# ============================================================================

[[ -f $HOME/.env.sh ]] && source $HOME/.env.sh
[[ -f $DOTFILES/zsh/aliases.zsh ]] && source $DOTFILES/zsh/aliases.zsh
[[ -f $DOTFILES/zsh/vask.zsh ]] && source $DOTFILES/zsh/vask.zsh

export VISUAL=nvim
export EDITOR=nvim
export MANPAGER="nvim +Man!"
export PAGER="less -S"

# ============================================================================
# Tools
# ============================================================================

# fnm (Node version manager)
eval "$(fnm env --use-on-cd --shell zsh --log-level=quiet)"

# Keep pnpm independent from the Node version managed by fnm.
export PATH="/opt/homebrew/opt/pnpm/bin:$PATH"

# Yazi shell wrapper
function y() {
  local tmp="$(mktemp -t "yazi-cwd.XXXXXX")"
  yazi "$@" --cwd-file="$tmp"
  if cwd="$(cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
    builtin cd -- "$cwd"
  fi
  rm -f -- "$tmp"
}

# bun completions
[[ -s "$HOME/.bun/_bun" ]] && source "$HOME/.bun/_bun"
