{
  "$schema": "https://opencode.ai/config.json",
  "model": "vercel/anthropic/claude-opus-4.6",
  "provider": {
    "vercel": {
      "models": {
        "anthropic/claude-sonnet-4.6": {
          "name": "Claude Sonnet 4.6",
          "variants": {
            "high": { "disabled": true }
          }
        },
        "anthropic/claude-sonnet-4.6[1M]": {
          "id": "anthropic/claude-sonnet-4.6",
          "name": "Claude Sonnet 4.6 [1M]",
          "headers": {
            "anthropic-beta": "context-1m-2025-08-07"
          },
          "limit": {
            "context": 1000000,
            "output": 64000
          }
        },
        "anthropic/claude-opus-4.5": { "name": "Claude Opus 4.5" },
        "anthropic/claude-opus-4.6": { "name": "Claude Opus 4.6" },
        "anthropic/claude-haiku-4.5": { "name": "Claude Haiku 4.5" },
        "google/gemini-3-flash": { "name": "Gemini 3 Flash" },
        "google/gemini-3.1-pro-preview": { "name": "Gemini 3.1 Pro Preview" },
        "openai/gpt-5.3-codex": { "name": "GPT-5.3 Codex" },
        "moonshotai/kimi-k2.5": { "name": "Kimi K2.5" },
        "zai/glm-5": { "name": "GLM 5" },
        "zai/glm-4.7": { "name": "GLM 4.7" },
        "alibaba/qwen3.5-flash": { "name": "Qwen 3.5 Flash" }
      }
    },
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1"
      },
      "models": {
        "qwen3-coder:30b": {
          "name": "Qwen3 Coder 30B (Local)"
        }
      }
    }
  },
  // Playwriter removed — using agent-browser skill instead
  "plugin": [
    "./plugin/sound-notification.ts",
    "@franlol/opencode-md-table-formatter@0.0.3",
    "./plugin/damage-control.ts",
    "oh-my-opencode@latest"
  ],
  "permission": {
    // Permission philosophy: allow by default, plugin/damage-control.ts blocks dangerous ops
    "read": "allow",
    "list": "allow",
    "glob": "allow",
    "grep": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "bash": {
      "*": "allow",
      // Sensitive file deny patterns (belt-and-suspenders alongside plugin)
      "cat */.ssh/*": "deny",
      "cat */.env*": "deny",
      "cat */.aws/*": "deny",
      "cat */.gcp/*": "deny",
      "cat */credentials*": "deny",
      // Destructive operations (deny)
      "sudo *": "deny",
      "chown *": "deny",
      "find * -delete*": "deny",
      "find * -exec*": "deny",
      "bun test *--update*": "deny",
      // Destructive operations (ask for approval — safety net)
      "rm *": "ask",
      "rm -rf *": "ask",
      "chmod *": "ask",
      // Git — write operations (ask)
      "git commit *": "ask",
      "git push *": "ask",
      // GitHub — block PR merging (requires human approval)
      "gh pr merge *": "deny",
      // agent-slack — write operations
      "agent-slack message send *": "ask",
      "agent-slack message react *": "ask",
      // linear-cli — write operations
      "linear-cli issues create *": "ask",
      "linear-cli issues update *": "ask",
      "linear-cli comments create *": "ask"
    },
    "edit": "allow",
    "write": "allow"
  }
}
