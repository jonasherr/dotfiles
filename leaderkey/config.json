				},
				{
					"key": "p",
					"label": "Confetti",
					"type": "url",
					"iconPath": "party.popper",
					"value": "raycast://confetti"
				},
				{
					"key": "c",
					"label": "Camera",
					"type": "url",
					"iconPath": "camera",
					"value": "raycast://extensions/raycast/system/open-camera"
				},
				{
					"key": "a",
					"label": "New Note",
					"type": "url",
					"iconPath": "note.text.badge.plus",
