				},
				{
					"key": "n",
					"label": "Search Notes",
					"type": "url",
					"iconPath": "magnifyingglass",
					"value": "raycast://extensions/jonas_herrmannsdorfer/nvim-markdown-notes/search-notes"
				}
			]
		},
	{
		"key": "w",
		"label": "Aerospace",
		"type": "group",
		"iconPath": "rectangle.3.group",
		"actions": [
			{
				"key": "r",
				"label": "Reset Layout",
				"type": "command",
				"iconPath": "arrow.counterclockwise",
