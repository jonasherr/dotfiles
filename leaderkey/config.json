			},
			{
				"key": "f",
				"label": "Toggle Floating",
				"type": "command",
				"iconPath": "rectangle.on.rectangle",
				"value": "$DOTFILES/leaderkey/scripts/aerospace-toggle-floating.sh"
			},
			{
				"key": "e",
				"label": "Balance Sizes",
				"type": "command",
				"iconPath": "rectangle.split.3x1",
