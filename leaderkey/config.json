			},
			{
				"key": "b",
				"label": "Close Others",
				"type": "command",
				"iconPath": "xmark.circle",
				"value": "$DOTFILES/leaderkey/scripts/aerospace-close-others.sh"
			},
			{
				"key": "s",
				"label": "Resize Mode",
				"type": "command",
				"iconPath": "arrow.up.left.and.arrow.down.right",
				"value": "$DOTFILES/leaderkey/scripts/aerospace-resize-mode.sh"
			}
		]
	},
	{
		"key": "a",
		"label": "Apps",
