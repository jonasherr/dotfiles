				{
					"key": "e",
					"label": "Desktop",
					"type": "folder",
					"iconPath": "desktopcomputer",
					"value": "~/Desktop"
				},
				{
					"key": "i",
					"label": "iCloud",
					"type": "folder",
					"iconPath": "icloud",
					"value": "~/Library/Mobile Documents/com~apple~CloudDocs"
