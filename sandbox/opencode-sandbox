#!/usr/bin/env bash
#
# OpenCode Sandbox — Host Wrapper
#
# Launches an OpenCode agent inside an Apple container microVM.
# Usage: ./opencode-sandbox <project-directory>

set -euo pipefail

readonly IMAGE_NAME="opencode-sandbox"
readonly PORT_START=4096
readonly PORT_END=4196
readonly HEALTH_TIMEOUT=30
readonly SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
readonly META_DIR="/tmp/opencode-sandbox"

# ── Helpers ───────────────────────────────────────────────────────────

info() {
  printf "\r  [ \033[00;34m..\033[0m ] %s\n" "$1"
}

success() {
  printf "\r  [ \033[00;32mOK\033[0m ] %s\n" "$1"
}

warn() {
  printf "\r  [ \033[0;33m!!\033[0m ] %s\n" "$1"
}

fail() {
  printf "\r  [\033[0;31mFAIL\033[0m] %s\n" "$1"
  exit 1
}

find_available_port() {
  local port
  for port in $(seq "$PORT_START" "$PORT_END"); do
    if ! lsof -Pi :"$port" -sTCP:LISTEN -t > /dev/null 2>&1; then
      echo "$port"
      return 0
    fi
  done
  fail "No available port in range ${PORT_START}-${PORT_END}"
}

save_metadata() {
  local name="$1" port="$2" project="$3" sock="$4"
  mkdir -p "$META_DIR"
  cat > "${META_DIR}/${name}.json" <<EOF
{"port":${port},"project":"${project}","container":"${name}","sock":"${sock}"}
EOF
}

remove_metadata() {
  local name="$1"
  rm -f "${META_DIR}/${name}.json"
}

# ── Usage ─────────────────────────────────────────────────────────────

usage() {
  echo "Usage: $(basename "$0") <project-directory>"
  echo ""
  echo "Launch an OpenCode agent sandbox for the given project."
  echo ""
  echo "Environment variables:"
  echo "  GIT_AUTHOR_NAME       Git author name (default: git config user.name, or OpenCode Agent)"
  echo "  GIT_AUTHOR_EMAIL      Git author email (default: git config user.email, or agent@opencode-sandbox)"
  echo "  GIT_COMMITTER_NAME    Git committer name (default: same as author)"
  echo "  GIT_COMMITTER_EMAIL   Git committer email (default: same as author)"
  echo "  OPENCODE_AUTH_DIR     Path to opencode data dir (default: ~/.local/share/opencode)"
  exit 1
}

# ── Cleanup trap ──────────────────────────────────────────────────────

container_name=""
relay_pid=""
sock_path=""
port=""

cleanup() {
  if [ -n "$relay_pid" ]; then
    kill "$relay_pid" 2>/dev/null || true
  fi
  if [ -n "$sock_path" ]; then
    rm -f "$sock_path"
  fi
  if [ -n "$container_name" ]; then
    echo ""
    warn "Script interrupted. Container '$container_name' may still be running."
    echo "  To reattach:  occ-attach (or: opencode attach http://127.0.0.1:${port})"
    echo "  To stop:      occ-stop (or: container stop $container_name && container rm $container_name)"
  fi
}

trap cleanup SIGINT SIGTERM

# ── Prerequisite checks ──────────────────────────────────────────────

check_prerequisites() {
  local project_dir="$1"

  # 1. container CLI
  if ! command -v container &> /dev/null; then
    fail "'container' CLI not found. Install from: https://github.com/apple/container/releases"
  fi

  # 2. container system running
  if ! container system status &> /dev/null; then
    fail "Container system not running. Start with: container system start"
  fi

  # 3. opencode CLI
  if ! command -v opencode &> /dev/null; then
    fail "'opencode' CLI not found. Install with: brew install sst/tap/opencode"
  fi

  # 4. project directory exists
  if [ ! -d "$project_dir" ]; then
    fail "Project directory not found: $project_dir"
  fi

  # 5. git repo (warn only)
  if ! git -C "$project_dir" rev-parse --git-dir > /dev/null 2>&1; then
    warn "$project_dir is not a git repository. Agent commits won't work."
    read -r -p "  Continue anyway? [y/N] " response
    if [[ ! "$response" =~ ^[Yy]$ ]]; then
      exit 1
    fi
  fi

  # 6. auth directory
  local auth_dir="${OPENCODE_AUTH_DIR:-$HOME/.local/share/opencode}"
  if [ ! -f "$auth_dir/auth.json" ]; then
    fail "Auth credentials not found at: $auth_dir/auth.json
  Run 'opencode auth login' to authenticate with your provider.
  Or set OPENCODE_AUTH_DIR to a custom path."
  fi

  # 7. disk space (warn if <5GB)
  local free_gb
  free_gb=$(df -g / | awk 'NR==2{print $4}')
  if [ "$free_gb" -lt 5 ] 2>/dev/null; then
    warn "Only ${free_gb}GB free disk space. Recommend at least 5GB."
    read -r -p "  Continue anyway? [y/N] " response
    if [[ ! "$response" =~ ^[Yy]$ ]]; then
      exit 1
    fi
  fi

  # 8. jq
  if ! command -v jq &> /dev/null; then
    fail "'jq' not found. Install with: brew install jq"
  fi

  # 9. curl
  if ! command -v curl &> /dev/null; then
    fail "'curl' not found. Install with: brew install curl"
  fi

  # 10. port availability checked dynamically (find_available_port)
}

# ── Image build ──────────────────────────────────────────────────────

ensure_image() {
  if container image ls --format json 2>/dev/null | jq -e ".[] | select(.name == \"${IMAGE_NAME}:latest\")" > /dev/null 2>&1; then
    success "Using existing ${IMAGE_NAME} image"
    echo "  To rebuild: container image rm ${IMAGE_NAME}:latest && re-run this script"
  else
    info "Building ${IMAGE_NAME} image (this may take a few minutes on first run)..."
    if ! container build -t "$IMAGE_NAME" "$SCRIPT_DIR"; then
      fail "Container image build failed. Check the Containerfile for errors."
    fi
    success "Image built successfully"
  fi
}

# ── Container cleanup ────────────────────────────────────────────────

cleanup_existing_containers() {
  local project_basename="$1"
  local prefix="opencode-${project_basename}"

  local existing
  existing=$(container ls --format json 2>/dev/null | jq -r --arg prefix "$prefix" '.[] | select(.configuration.id | startswith($prefix)) | .configuration.id' 2>/dev/null || true)

  if [ -n "$existing" ]; then
    warn "Found existing container(s) for this project:"
    echo "$existing" | while read -r cname; do
      echo "  - $cname"
    done
    read -r -p "  Stop and remove them? [Y/n] " response
    if [[ ! "$response" =~ ^[Nn]$ ]]; then
      echo "$existing" | while read -r cname; do
        container stop "$cname" 2>/dev/null || true
        container rm "$cname" 2>/dev/null || true
        info "Removed $cname"
      done
    else
      warn "Existing containers may be using ports. New sandbox will find an available port."
    fi
  fi
}

# ── Health check ─────────────────────────────────────────────────────

wait_for_healthy() {
  local name="$1"
  local sock="$2"
  local elapsed=0

  printf "  Waiting for OpenCode server"
  while [ "$elapsed" -lt "$HEALTH_TIMEOUT" ]; do
    # Crash detection: check container is still running
    local status
    status=$(container ls --format json 2>/dev/null | jq -r --arg name "$name" '.[] | select(.configuration.id == $name) | .status' 2>/dev/null || echo "unknown")
    if [ "$status" != "running" ] && [ "$status" != "unknown" ]; then
      echo " FAILED"
      fail "Container crashed during startup. Check logs:
  container logs $name
  container logs --boot $name"
    fi

    # Health check via Unix socket (--publish TCP is broken in Apple container)
    if curl -sf --unix-socket "$sock" http://localhost/global/health 2>/dev/null | jq -e '.healthy == true' > /dev/null 2>&1; then
      echo " ready!"
      return 0
    fi

    sleep 1
    elapsed=$((elapsed + 1))
    printf "."
  done

  echo " TIMEOUT after ${HEALTH_TIMEOUT}s"
  fail "Server did not become healthy. Check logs:
  container logs $name"
}

# ── Main ─────────────────────────────────────────────────────────────

main() {
  if [ $# -lt 1 ]; then
    usage
  fi

  local project_dir
  project_dir="$(cd "$1" 2>/dev/null && pwd)" || fail "Cannot resolve directory: $1"

  local project_basename
  project_basename="$(basename "$project_dir")"

  local auth_dir="${OPENCODE_AUTH_DIR:-$HOME/.local/share/opencode}"

  local git_author_name="${GIT_AUTHOR_NAME:-$(git config user.name 2>/dev/null || echo "OpenCode Agent")}"
  local git_author_email="${GIT_AUTHOR_EMAIL:-$(git config user.email 2>/dev/null || echo "agent@opencode-sandbox")}"
  local git_committer_name="${GIT_COMMITTER_NAME:-$git_author_name}"
  local git_committer_email="${GIT_COMMITTER_EMAIL:-$git_author_email}"

  echo ""
  info "OpenCode Sandbox"
  echo ""

  check_prerequisites "$project_dir"
  ensure_image
  cleanup_existing_containers "$project_basename"

  # Find available port
  port=$(find_available_port)

  container_name="opencode-${project_basename}-$(date +%s)"

  info "Starting container: $container_name (port $port)"

  sock_path="/tmp/opencode-${project_basename}-${port}.sock"
  rm -f "$sock_path"

  if ! container run -d \
    --name "$container_name" \
    --memory 4g \
    --cpus 4 \
    --volume "$project_dir":/workspace \
    --volume "$auth_dir":/root/.local/share/opencode \
    --volume "$HOME/.cache/oh-my-opencode":/root/.cache/oh-my-opencode \
    --volume "$HOME/.config/opencode/skills":/config/skills \
    --volume "$HOME/.agents/skills":/root/.agents/skills \
    --publish-socket "$sock_path":/tmp/opencode.sock \
    --env GIT_AUTHOR_NAME="$git_author_name" \
    --env GIT_AUTHOR_EMAIL="$git_author_email" \
    --env GIT_COMMITTER_NAME="$git_committer_name" \
    --env GIT_COMMITTER_EMAIL="$git_committer_email" \
    "$IMAGE_NAME"; then
    fail "Failed to start container"
  fi

  wait_for_healthy "$container_name" "$sock_path"

  # Start TCP relay: host TCP:${port} → Unix socket → container
  # (Apple container --publish TCP is broken; use --publish-socket + relay instead)
  python3 -c "
import socket, threading, signal, sys
def relay(src, dst):
    try:
        while True:
            data = src.recv(65536)
            if not data: break
            dst.sendall(data)
    except: pass
    finally:
        try: src.close()
        except: pass
        try: dst.close()
        except: pass
signal.signal(signal.SIGTERM, lambda *a: sys.exit(0))
server = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
server.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
server.bind(('127.0.0.1', ${port}))
server.listen(5)
while True:
    client, _ = server.accept()
    unix = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    unix.connect('${sock_path}')
    threading.Thread(target=relay, args=(client, unix), daemon=True).start()
    threading.Thread(target=relay, args=(unix, client), daemon=True).start()
" &
  relay_pid=$!

  # Save metadata for occ-attach / occ-stop
  save_metadata "$container_name" "$port" "$project_dir" "$sock_path"

  echo ""
  success "OpenCode sandbox running"
  success "Project: $project_dir → /workspace"
  success "Container: $container_name"
  success "Git identity: $git_author_name <$git_author_email>"
  echo "  (Override with: export GIT_AUTHOR_NAME='Your Name' GIT_AUTHOR_EMAIL='you@email.com')"
  echo ""
  info "Attaching TUI... (Ctrl+C to detach, container keeps running)"
  echo ""
  info "To reattach later:"
  echo "    occ-attach (or: opencode attach http://127.0.0.1:${port})"
  echo ""
  info "To stop:"
  echo "    occ-stop (or: container stop $container_name && container rm $container_name)"
  echo ""

  # Attach TUI — blocks until user exits
  opencode attach "http://127.0.0.1:${port}" || true

  # After TUI exits
  echo ""
  info "TUI detached. Container '$container_name' is still running."
  read -r -p "  Stop container now? [y/N] " response
  # Clean up relay
  if [ -n "$relay_pid" ]; then
    kill "$relay_pid" 2>/dev/null || true
  fi
  rm -f "$sock_path"

  if [[ "$response" =~ ^[Yy]$ ]]; then
    info "Stopping container..."
    container stop "$container_name" 2>/dev/null || true
    container rm "$container_name" 2>/dev/null || true
    remove_metadata "$container_name"
    success "Container stopped and removed"
  else
    echo ""
    info "Container still running. To reattach:"
    echo "    occ-attach (or: opencode attach http://127.0.0.1:${port})"
    echo ""
    info "To stop later:"
    echo "    occ-stop (or: container stop $container_name && container rm $container_name)"
  fi
}

main "$@"
