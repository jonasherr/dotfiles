#!/usr/bin/env bash
# Entrypoint for the `inbox` CLI. Resolves to the skill's TS source and runs
# it with tsx. Symlinked into ~/.local/bin/ by the dotfiles bootstrap.
set -euo pipefail

# Resolve real path (follow symlinks) so $here points at the skill directory
# regardless of how the script was invoked.
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  dir="$(cd -P "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  [[ "$src" != /* ]] && src="$dir/$src"
done
here="$(cd -P "$(dirname "$src")/.." && pwd)"

# Suppress the node:sqlite ExperimentalWarning (we use the built-in SQLite
# binding for the Envelope Index backend; stable in Node 22+ but still
# emits a warning).
export NODE_NO_WARNINGS=1

if command -v tsx >/dev/null 2>&1; then
  exec tsx "$here/src/cli.ts" "$@"
else
  exec npx --yes tsx "$here/src/cli.ts" "$@"
fi
