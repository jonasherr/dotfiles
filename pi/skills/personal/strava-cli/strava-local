#!/usr/bin/env bash
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
  DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
DIR="$(cd "$(dirname "$SOURCE")" && pwd)"

if [[ -f "$DIR/dist/strava-local.js" ]]; then
  exec node "$DIR/dist/strava-local.js" "$@"
fi

exec npx --yes tsx "$DIR/src/strava-local.ts" "$@"
