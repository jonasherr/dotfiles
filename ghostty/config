# cmux / Ghostty config
# cmux reads from ~/.config/ghostty/config

# Theme (custom, in themes/everforest-dark-soft)
theme = everforest-dark-soft

# Font (matching kitty)
font-family = GeistMono Nerd Font Mono
font-size = 18

# For screen sharing, uncomment:
# font-size = 26

# Scrollback
scrollback-limit = 2000

# Shell
command = zsh --login

# Window
window-padding-y = 16

# Splits (colors from Everforest Dark Soft)
unfocused-split-opacity = 0.7
unfocused-split-fill = #333c43
split-divider-color = #5d6b66

# Keybinds

# Pane navigation — vim-style (matching kitty ctrl+h/j/k/l)
# Note: ctrl+h (backspace) and ctrl+l (clear) will be consumed by these
keybind = ctrl+j=goto_split:bottom
keybind = ctrl+k=goto_split:top
keybind = ctrl+h=goto_split:left
keybind = ctrl+l=goto_split:right

# Pane resize
keybind = ctrl+shift+h=resize_split:left,40
keybind = ctrl+shift+l=resize_split:right,40
keybind = ctrl+shift+j=resize_split:down,40
keybind = ctrl+shift+k=resize_split:up,40

# Toggle split zoom (like kitty toggle_layout stack)
keybind = ctrl+shift+z=toggle_split_zoom

# Reload config (matching kitty ctrl+cmd+,)
keybind = ctrl+super+comma=reload_config

# Copy URL under cursor (no hint overlay like kitty, but closest equivalent)
keybind = ctrl+shift+e=copy_url_to_clipboard

# shift+enter sends escape + return (matches kitty config)
keybind = shift+enter=text:\x1b\x0d
