;; Kanata configuration
;;
;; Designed for a 40-key mindset (3×10 grid + 3 thumb keys)
;; but intercepts full MacBook keyboard so all physical keys still work.
;;
;; Features:
;; - Home row mods (a/s/d/f and j/k/l/;)
;; - System layer (g hold) — media, brightness, tabs, live reload
;; - Hyper key (Caps Lock tap=Esc, hold=Hyper)
;; - MEH key (Space tap=Space, hold=Meh)
;; - Symbol layer (left command hold) — numbers on home row, symbols on top
;; - Numbers layer (right command hold) — numpad on right hand
;; - Navigation layer (e hold) — arrows, word-jump, selection, delete
;;
;; 40-key layout reference (keys you should use):
;;
;;   q  w  e  r  t    y  u  i  o  p
;;   a  s  d  f  g    h  j  k  l  ;
;;   z  x  c  v  b    n  m  ,  .  /
;;         lmet spc rmet
;;
;; Plus: function/media row, caps(hyper), lsft, rsft, bspc, ret, tab

;; ============================================================================
;; Configuration
;; ============================================================================

(defcfg
  ;; Keep unmapped keys out of Kanata so macOS handles the hardware
  ;; function/media row directly. All normal MacBook keyboard keys are
  ;; already listed in defsrc below.
  process-unmapped-keys no
  concurrent-tap-hold yes

  ;; Only apply to MacBook internal keyboard, not external keyboards
  macos-dev-names-include (
    "Apple Internal Keyboard / Trackpad"
  )
)

;; ============================================================================
;; Variables
;; ============================================================================

(defvar
  tap-timeout 200
  hold-timeout 200
)

;; ============================================================================
;; Source - Define which keys kanata will intercept
;; ============================================================================
;; We list the normal MacBook keyboard keys explicitly.
;; The MacBook hardware row mostly arrives as F-keys through Kanata, but
;; the previous/play/next keys arrive as media keys on some MacBook models.
;; The base layer sends the matching macOS media actions.
;; Layer design only uses the 40-key zone.

(defsrc
  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lmet lalt           spc            ralt rmet rctl
)

;; ============================================================================
;; Aliases
;; ============================================================================

(defalias
  ;; Home Row Mods - Left Hand
  a (tap-hold $tap-timeout $hold-timeout a lctl)
  s (tap-hold $tap-timeout $hold-timeout s lalt)
  d (tap-hold $tap-timeout $hold-timeout d lmet)
  f (tap-hold $tap-timeout $hold-timeout f lsft)

  ;; e: tap for 'e', hold for navigation layer
  e (tap-hold $tap-timeout $hold-timeout e (layer-toggle nav))

  ;; g: tap for 'g', hold for system layer
  g (tap-hold $tap-timeout $hold-timeout g (layer-toggle system))

  ;; Home Row Mods - Right Hand
  j (tap-hold $tap-timeout $hold-timeout j rsft)
  k (tap-hold $tap-timeout $hold-timeout k rmet)
  l (tap-hold $tap-timeout $hold-timeout l ralt)
  ; (tap-hold $tap-timeout $hold-timeout ; rctl)

  ;; Numbers Layer Home Row Mods (same modifiers, tap = digit)
  n1 (tap-hold $tap-timeout $hold-timeout 1 lctl)
  n2 (tap-hold $tap-timeout $hold-timeout 2 lalt)
  n3 (tap-hold $tap-timeout $hold-timeout 3 lmet)
  n4 (tap-hold $tap-timeout $hold-timeout 4 lsft)
  n7 (tap-hold $tap-timeout $hold-timeout 7 rsft)
  n8 (tap-hold $tap-timeout $hold-timeout 8 rmet)
  n9 (tap-hold $tap-timeout $hold-timeout 9 ralt)
  n0 (tap-hold $tap-timeout $hold-timeout 0 rctl)

  ;; Hyper Key - Caps Lock: tap=Esc, hold=Hyper (Ctrl+Option+Shift+Command)
  cap (tap-hold $tap-timeout $hold-timeout esc (multi lctl lalt lsft lmet))

  ;; MEH Key - Space: tap=Space, hold=Meh (Ctrl+Option+Shift)
  spc (tap-hold $tap-timeout $hold-timeout spc (multi lctl lalt lsft))

  ;; Layer Activators (hold-to-activate)
  ;; Left Command: tap=lmet, hold=symbol layer
  lmc (tap-hold $tap-timeout $hold-timeout lmet (layer-toggle symbol))
  ;; Right Command: tap=rmet, hold=numbers layer
  rmc (tap-hold $tap-timeout $hold-timeout rmet (layer-toggle numbers))
)

;; ============================================================================
;; Base Layer
;; ============================================================================
;; Number row and outer keys pass through as-is for when you're on the MacBook.
;; The 40-key zone is where the action is.

(deflayer base
  brdn brup mctl sls  dtn  dnd  (arbitrary-code 165) (arbitrary-code 164) (arbitrary-code 163) mute vold volu
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    @e   r    t    y    u    i    o    p    [    ]    \
  @cap @a   @s   @d   @f   @g   h    @j   @k   @l   @;   '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl @lmc lalt           @spc           ralt @rmc rctl
)

;; ============================================================================
;; Special Layer - Symbol mappings (hold left command)
;; ============================================================================
;; Based on original Karabiner special layer mappings

(deflayer symbol
  _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    q    S-2  S-3  grv  S-'  S-7  S-,  S-.  S--  -    _    _    _
  _    S-6  S-5  S-8  S-4  '    \    S-[  S-]  S-\  S-grv _   _
  _    S--  =    S-grv S-6 S-1  [    S-9  S-0  ]    S-=  _
  _    _    _              _              _    _    _
)

;; ============================================================================
;; Numbers Layer (hold right command)
;; ============================================================================
;; 1-0 across home row: left hand 1-5, right hand 6-0.

(deflayer numbers
  _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    @n1  @n2  @n3  @n4  5    6    @n7  @n8  @n9  @n0  _    _
  _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _              _              _    _    _
)

;; ============================================================================
;; System Layer (hold g)
;; ============================================================================
;; Right hand: media, volume, brightness, tab switching
;; Space: live reload
;;
;;   top:               prev brdn brup next
;;  home:               ⌘⇧[  vol- vol+ ⌘⇧]
;;   bot:               pp
;;   spc:  lrld

(deflayer system
  _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    prev brdn brup next _    _    _    _
  _    _    _    _    _    _    M-S-[ vold volu M-S-] _  _    _
  _    _    _    _    _    _    _    pp   _    _    _    _
  _    _    _              lrld           _    _    _
)

;; ============================================================================
;; Navigation Layer (hold e)
;; ============================================================================
;; Arrows on HJKL (vim-style), word-jump, selection, Home/End, delete shortcuts
;;
;;   top:                      Home pgdn pgup End PgUp
;;  home:                 ⌘↑   ←    ↓    ↑    →
;;   bot:                 ⌘↓   PgDn ⌥Bspc Bspc del  ⌘Bspc
;;
;; With host mods (hold s=Alt, d=Cmd, f=Shift on base) you get:
;;   Shift+arrows = select text
;;   Alt+arrows   = word jump
;;   Cmd+arrows   = line start/end
;;   Shift+Alt+arrows = select by word

(deflayer nav
  _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    home pgdn pgup end  pgup _    _    _
  _    _    _    _    _    M-up left down up   rght _    _    _
  _    _    _    _    _    M-down pgdn A-bspc bspc del M-bspc _
  _    _    _              _              _    _    _
)
